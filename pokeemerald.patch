+static void UpdateOptionMenuScroll(u8 taskId)
+{
+    u8 selection = gTasks[taskId].tMenuSelection;
+    u8 prevScrollOffset = sMenuScrollOffset;
+
+    if (selection < sMenuScrollOffset)
+      sMenuScrollOffset = selection;
+    else if (selection >= sMenuScrollOffset + VISIBLE_MENU_ITEMS)
+      sMenuScrollOffset = selection - VISIBLE_MENU_ITEMS + 1;
+
+    if (prevScrollOffset != sMenuScrollOffset)
+    {
+        DrawOptionMenuTexts();
+        DrawVisibleOptionChoices(taskId);
+        CopyWindowToVram(WIN_OPTIONS, COPYWIN_FULL);
+    }
+
+    HighlightOptionMenuItem(selection);
+}
