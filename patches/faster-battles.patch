@@ -55,6 +71,9 @@ void HandleIntroSlide(u8 environment)
         environment = BATTLE_ENVIRONMENT_UNDERWATER;
         taskId = CreateTask(BattleIntroSlide2, 0);
     }
+    else if (ShouldUseFastBattleIntro()) {
