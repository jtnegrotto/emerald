+static bool8 IsBattleIntroPlayerBusy(void)
+{
+    if (ShouldUseFastBattleIntro())
+    {
+        u8 battler = GetBattlerAtPosition(B_POSITION_PLAYER_LEFT);
+        return (gBattleControllerExecFlags & gBitTable[battler]) != 0;
+    }
+
+    return gBattleControllerExecFlags != 0;
+}
+
+static bool8 CanOverlapIntroSendOut(void)
+{
+    u8 player, opponent;
+
+    if (!ShouldUseFastBattleIntro())
+        return FALSE;
+
+    player = GetBattlerAtPosition(B_POSITION_PLAYER_LEFT);
+    opponent = GetBattlerAtPosition(B_POSITION_OPPONENT_LEFT);
+
+    if (IsMonShiny(&gPlayerParty[gBattlerPartyIndexes[player]])
+     || IsMonShiny(&gEnemyParty[gBattlerPartyIndexes[opponent]]))
+        return FALSE;
+
+    if (IsCryPlayingOrClearCrySongs())
+        return FALSE;
+
+    return TRUE;
+}
