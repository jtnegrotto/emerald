+static void DrawVisibleOptionChoices(u8 taskId)
+{
+    u8 first = sMenuScrollOffset;
+    u8 last = first + VISIBLE_MENU_ITEMS;
+
+    if (MENUITEM_TEXTSPEED >= first && MENUITEM_TEXTSPEED < last)
+        TextSpeed_DrawChoices(gTasks[taskId].tTextSpeed);
+
+    if (MENUITEM_BATTLESCENE >= first && MENUITEM_BATTLESCENE < last)
+        BattleScene_DrawChoices(gTasks[taskId].tBattleSceneOff);
+
+    if (MENUITEM_BATTLESTYLE >= first && MENUITEM_BATTLESTYLE < last)
+        BattleStyle_DrawChoices(gTasks[taskId].tBattleStyle);
+
+    if (MENUITEM_SOUND >= first && MENUITEM_SOUND < last)
+        Sound_DrawChoices(gTasks[taskId].tSound);
+
+    if (MENUITEM_BUTTONMODE >= first && MENUITEM_BUTTONMODE < last)
+        ButtonMode_DrawChoices(gTasks[taskId].tButtonMode);
+
+    if (MENUITEM_FRAMETYPE >= first && MENUITEM_FRAMETYPE < last)
+        FrameType_DrawChoices(gTasks[taskId].tWindowFrameType);
+
+    if (MENUITEM_AUTORUN >= first && MENUITEM_AUTORUN < last)
+        AutoRun_DrawChoices(gTasks[taskId].tAutoRun);
+}
+
+static void UpdateOptionMenuScroll(u8 taskId)
+{
+    u8 selection = gTasks[taskId].tMenuSelection;
+    u8 prevScrollOffset = sMenuScrollOffset;
+
+    if (selection < sMenuScrollOffset)
+        sMenuScrollOffset = selection;
+    else if (selection >= sMenuScrollOffset + VISIBLE_MENU_ITEMS)
+        sMenuScrollOffset = selection - VISIBLE_MENU_ITEMS + 1;
+
+    if (prevScrollOffset != sMenuScrollOffset)
+    {
+        DrawOptionMenuTexts();
+        DrawVisibleOptionChoices(taskId);
+        CopyWindowToVram(WIN_OPTIONS, COPYWIN_FULL);
+    }
+
+    HighlightOptionMenuItem(selection);
+}
