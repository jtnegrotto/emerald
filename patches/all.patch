diff --git a/src/dns.c b/src/dns.c
new file mode 100644
index 000000000..beda55e58
--- /dev/null
+++ b/src/dns.c
@@ -0,0 +1,105 @@
+#include "global.h"
+#include "dns.h"
+#include "overworld.h"
+#include "palette.h"
+#include "rtc.h"
+#include "constants/rgb.h"
+
+#define TINT_MORNING  Q_8_8(0.95), Q_8_8(1.00), Q_8_8(0.85)
+#define TINT_DAY      Q_8_8(1.00), Q_8_8(1.00), Q_8_8(1.00)
+#define TINT_EVENING  Q_8_8(1.00), Q_8_8(0.80), Q_8_8(0.60)
+#define TINT_TWILIGHT Q_8_8(0.90), Q_8_8(0.60), Q_8_8(0.95)
+#define TINT_NIGHT    Q_8_8(0.45), Q_8_8(0.45), Q_8_8(0.95)
+
+static const u16 sTimeOfDayTints[24][3] =
+{
+    [0]  = {TINT_NIGHT},
+    [1]  = {TINT_NIGHT},
+    [2]  = {TINT_NIGHT},
+    [3]  = {TINT_NIGHT},
+    [4]  = {TINT_NIGHT},
+    [5]  = {TINT_TWILIGHT},
+    [6]  = {TINT_MORNING},
+    [7]  = {TINT_MORNING},
+    [8]  = {TINT_DAY},
+    [9]  = {TINT_DAY},
+    [10] = {TINT_DAY},
+    [11] = {TINT_DAY},
+    [12] = {TINT_DAY},
+    [13] = {TINT_DAY},
+    [14] = {TINT_DAY},
+    [15] = {TINT_DAY},
+    [16] = {TINT_DAY},
+    [17] = {TINT_DAY},
+    [18] = {TINT_EVENING},
+    [19] = {TINT_EVENING},
+    [20] = {TINT_TWILIGHT},
+    [21] = {TINT_NIGHT},
+    [22] = {TINT_NIGHT},
+    [23] = {TINT_NIGHT}
+};
+
+static void GetCurrentTint(u16 *tint)
+{
+    s32 hour, nextHour, minute;
+    s32 i;
+
+    RtcCalcLocalTime();
+
+    hour = gLocalTime.hours;
+    minute = gLocalTime.minutes;
+
+    if (hour < 0 || hour >= 24 || minute < 0 || minute >= 60)
+    {
+        tint[0] = Q_8_8(1.0);
+        tint[1] = Q_8_8(1.0);
+        tint[2] = Q_8_8(1.0);
+        return;
+    }
+
+    nextHour = (hour + 1) % 24;
+    for (i = 0; i < 3; i++) {
+        s32 from = sTimeOfDayTints[hour][i];
+        s32 to = sTimeOfDayTints[nextHour][i];
+        tint[i] = from + (to - from) * minute / 60;
+    }
+}
+
+void ApplyDNSTint(u16 *palette, u16 count, const u16 *tint)
+{
+    u16 i;
+
+    for (i = 0; i < count; i++)
+    {
+        u16 color = palette[i];
+        u16 r = (GET_R(color) * tint[0]) >> 8;
+        u16 g = (GET_G(color) * tint[1]) >> 8;
+        u16 b = (GET_B(color) * tint[2]) >> 8;
+
+        palette[i] = RGB(r, g, b);
+    }
+}
+
+void LoadPaletteWithDNS(const void *src, u16 offset, u16 size)
+{
+    u16 tint[3];
+
+    LoadPalette(src, offset, size);
+
+    if (!IsMapTypeOutdoors(gMapHeader.mapType))
+      return;
+
+    GetCurrentTint(tint);
+
+    ApplyDNSTint(
+     gPlttBufferUnfaded + offset,
+     size / sizeof(u16),
+     tint
+    );
+
+    CpuCopy16(
+        gPlttBufferUnfaded + offset,
+        gPlttBufferFaded + offset,
+        size
+    );
+}
